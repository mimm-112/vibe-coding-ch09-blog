# ============================================================
# 챕터 09 블로그 : 환경 변수
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채우세요.
#   cp .env.local.example .env.local
#
# 값은 수파베이스 대시보드 상단 [Connect] 버튼에서 확인합니다.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# 수파베이스가 Anon Key -> Publishable Key 로 이름을 바꾸는 중입니다.
# [Connect]에 보이는 이름 그대로 둘 중 하나만 채우면 됩니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
